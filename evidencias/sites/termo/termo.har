t));margin-top:var(--inset);-webkit-user-select:none;-moz-user-select:none;user-select:none;width:100%}a{color:#ebe}wc-notify{flex-shrink:0;height:6vh;margin:0}@-webkit-keyframes popup{0%{opacity:0;-webkit-transform:scale(0);transform:scale(0)}25%{opacity:1}75%{-webkit-transform:scale(1.15);transform:scale(1.15)}to{opacity:1;-webkit-transform:scale(1);transform:scale(1)}}@keyframes popup{0%{opacity:0;-webkit-transform:scale(0);transform:scale(0)}25%{opacity:1}75%{-webkit-transform:scale(1.15);transform:scale(1.15)}to{opacity:1;-webkit-transform:scale(1);transform:scale(1)}}main{grid-gap:1rem;align-items:center;box-sizing:border-box;display:grid;flex-grow:1;flex-shrink:50;height:100%;justify-content:center;justify-items:center;margin:0 auto;overflow-x:hidden;overflow-y:auto;padding:2rem 0;-webkit-user-select:none;-moz-user-select:none;user-select:none;width:min(var(--max-size),100%)}main::-webkit-scrollbar{background-color:transparent;width:12px}main::-webkit-scrollbar-thumb{background:#625256;border-radius:6px}.help_termo,wc-modal{display:none}.help_multi{display:block}#help{line-height:1em;overflow:auto;pointer-events:auto}#help p{color:#bbb;font-size:1em;font-weight:300;line-height:1.35em}#help .example{font-size:.333em}#help .example .letter{font-size:3.5em}#help .letter{align-items:center;border:.125em solid #4c4347;border-radius:10%;box-sizing:border-box;color:#fafaff;display:inline-flex;font-weight:500;height:2em;justify-content:center;margin:0 .05em;width:2em}#help p .letter{font-size:1em;height:1.75em;vertical-align:15%;width:1.75em}#help .letter.right{background-color:var(--colorRight);border:none}#help .letter.place{background-color:var(--colorPlace);border:none}#help .letter.wrong{background-color:#191516;border:none;color:#5e5c5c}@media only screen and (min-width:100vh){:root{--kbd-height:min(100em/2.15,25vh)}html{max-width:1440px}main{grid-gap:3rem;padding:3rem;width:100%}wc-header,wc-kbd{margin:0 auto;max-width:var(--max-size);width:100%}}#editor{align-items:center;border-radius:2em;display:none;flex-direction:column;height:80%;justify-content:start;width:90%}#editor h2{font-size:5em;font-weight:500;margin:2em;text-align:center}#editor button{align-items:center;background-color:#009afe;border:none;border-radius:.25em;color:#fafaff;cursor:pointer;display:flex;font-size:4em;justify-content:center;margin-top:4em;padding:.75em 1.25em}</style>\n<style id=\"style_termo\" media=\"not all\">main{grid-template-columns:1fr;grid-template-rows:1fr;padding:0;width:var(--board-width)}.help_termo{display:block}.help_multi{display:none}@media not all and (-webkit-min-device-pixel-ratio:0),not all and (min-resolution:.001dpcm){main{grid-template-columns:100%;grid-template-rows:100%}}</style>\n\n<style id=\"style_duo\" media=\"not all\">main{grid-template-columns:1fr 1fr;grid-template-rows:1fr}@media not all and (-webkit-min-device-pixel-ratio:0),not all and (min-resolution:.001dpcm){main{grid-template-columns:calc(50% - 1.5rem) calc(50% - 1.5rem);grid-template-rows:100%}}</style>\n\n<style id=\"style_quatro\" media=\"not all\">:root{--kbd-height:min(100em/2.15,15vh)}wc-notify{flex-shrink:0;height:4vh}main{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}@media not all and (-webkit-min-device-pixel-ratio:0),not all and (min-resolution:.001dpcm){main{grid-template-columns:calc(50% - 1.5rem) calc(50% - 1.5rem);grid-template-rows:calc(50% - 1.5rem) calc(50% - 1.5rem)}}@media only screen and (min-width:100vh){main{grid-template-columns:repeat(4,1fr);grid-template-rows:1fr}@media not all and (-webkit-min-device-pixel-ratio:0),not all and (min-resolution:.001dpcm){main{grid-template-columns:repeat(4,calc(25% - .75rem));grid-template-rows:100%}}}</style>\n\n</head>\n<body onunload>\n<wc-bar></wc-bar>\n<wc-header stats=\"true\"></wc-header>\n\n<wc-notify></wc-notify>\n\n<main></main>\n\n<wc-kbd></wc-kbd>\n\n<wc-modal>\n  <div tabindex=\"0\" id=\"help\"> <p tabindex=\"0\" class=\"help_multi\">Descubra as palavras certas. Depois de cada\n tentativa, as peças mostram o quão perto você está da solução.</p>\n <p tabindex=\"0\" class=\"help_termo\">Descubra a palavra certa em 6 tentativas.\n Depois de cada tentativa, as peças mostram o quão perto você está da solução.\n\n  </p><div class=\"example\">\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra T correta\" class=\"letter right\">T</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra U\" class=\"letter\">U</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra R\" class=\"letter\">R</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra M\" class=\"letter\">M</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra A\" class=\"letter\">A</span>\n  </div>\n\n  <p tabindex=\"0\">A letra <span class=\"letter right\">T</span> faz parte da palavra e está na\n  posição correta.</p>\n\n  <div class=\"example\">\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra V\" class=\"letter\">V</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra I\" class=\"letter\">I</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra O em outro local\" class=\"letter place\">O</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra L\" class=\"letter\">L</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra A\" class=\"letter\">A</span>\n  </div>\n\n  <p tabindex=\"0\">A letra <span class=\"letter place\">O</span> faz parte da palavra mas em outra posição.</p>\n\n  <div class=\"example\">\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra P\" class=\"letter\">P</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra U\" class=\"letter\">U</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra L\" class=\"letter\">L</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra G errada\" class=\"letter wrong\">G</span>\n    <span tabindex=\"0\" role=\"text\" aria-label=\"letra A\" class=\"letter\">A</span>\n  </div>\n\n  <p tabindex=\"0\">A letra <span class=\"letter wrong\">G</span> não faz parte da palavra.</p>\n\n  <p tabindex=\"0\">Os acentos são preenchidos automaticamente, e não são considerados nas dicas.</p>\n\n  <p tabindex=\"0\">As palavras podem possuir letras repetidas.</p>\n\n  <div class=\"help_termo\">\n    <br><p tabindex=\"0\">Uma palavra nova aparece a cada dia.</p>\n  </div>\n</div>\n  <wc-config boxes=\"contrast,multi\"></wc-config>\n  <wc-stats id=\"stats\" stato=\"false\" range=\"4-9\" death=\"true\"></wc-stats>\n</wc-modal>\n\n  <script type=\"module\" src=\"multi.811eb29.js\"></script>\n\n\n\n</body></html>"
